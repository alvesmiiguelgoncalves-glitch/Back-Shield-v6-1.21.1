  "environment": "*",
  "entrypoints": {
    "main": [ "net.backshield.BackShieldMain" ],
    "client": [ "net.backshield.client.BackShieldClient" ]
  },
  "depends": {
    "java": ">=21",
    "minecraft": "~1.21.1",
    "fabricloader": ">=0.16.5",
    "fabric-api": "*",
